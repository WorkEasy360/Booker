{
  "name": "workeasy360-server",
  "version": "0.1.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "seed": "tsx src/db/seed.ts",
    "test:e2e": "node scripts/e2e-api.mjs",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore": "tsx scripts/db-restore.ts",
    "db:status": "tsx scripts/db-status.ts",
    "org:create": "tsx scripts/create-organization.ts",
    "email:test": "tsx scripts/email-test.ts",
    "mail:catcher": "node scripts/mail-catcher.mjs",
    "test:email": "node scripts/email-flows.mjs",
    "test:smoke": "node scripts/smoke-production.mjs"
  },
  "dependencies": {
    "@types/cookie-parser": "^1.4.10",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "libphonenumber-js": "1.13.15",
    "nanoid": "^3.3.7",
    "nodemailer": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.16.0",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "smtp-server": "^3.21.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.0",
    "typescript": "^5.5.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": [
      "./jest.setup.js"
    ],
    "testMatch": [
      "**/src/tests/**/*.test.ts"
    ],
    "setupFilesAfterEnv": [
      "./jest.teardown.ts"
    ],
    "globalSetup": "./jest.global-setup.cjs",
    "globalTeardown": "./jest.global-teardown.cjs",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs"
          }
        }
      ]
    }
  }
}
