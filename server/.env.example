# WorkEasy360 Server — Environment Variables
# Copy this file to .env and fill in your values.

# Server port (default: 3001)
PORT=3001

# Origin(s) of the WorkEasy360 web app, comma-separated, no path (e.g. https://app.example.com).
# Only these origins may send changes (POST/PUT/DELETE); production requires https and refuses "*".
# The origin of PUBLIC_APP_URL is allowed automatically.
CORS_ORIGIN=http://localhost:5173

# Session signing secret — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Production refuses to start if it is missing, shorter than 32 characters or still this placeholder.
# Changing it signs everyone out and invalidates manage-booking links in emails already sent.
JWT_SECRET=replace_with_a_long_random_secret_at_least_64_chars

# Session lifetime, between 5m and 30d (default: 7d). Sessions are also stored server-side and end on
# logout, password change or when the user is deactivated.
JWT_EXPIRES_IN=7d

# Set when the API runs behind a reverse proxy or load balancer, so rate limits see real client addresses:
# the number of proxy hops (usually 1), "loopback", or the proxy's address/subnet. Leave unset otherwise
# (X-Forwarded-For is then ignored, so it cannot be spoofed).
# TRUST_PROXY=1

# Rate limits are on by default (sign-in, signup, public booking, booking lookup, self-service changes,
# email resends). They are in-memory, so run a single API process. Only automated tests turn them off.
# RATE_LIMITS=off

# SQLite database file path (relative to server root)
DB_PATH=./data/workeasy360.db

# Demo admin account for `npm run seed` only (development demo data; the seed refuses to run with
# NODE_ENV=production). Leave these commented out: without them the seed uses the same development defaults.
# Never set them on a production server.
# ADMIN_EMAIL=admin@workeasy360.com
# ADMIN_PASSWORD=Admin123!

# ─── AI Operator ──────────────────────────────────────────────────────────────

# Without GEMINI_API_KEY the assistant uses local knowledge retrieval only. With it, questions are answered by Google
# Gemini (server side only: the key is never sent to browsers or logged). What is sent to Google: the question, the
# conversation's recent messages, help-article excerpts and the business records the assistant looks up to answer.
# Secret: set it in the host's protected settings, never commit a real value. GEMINI_MODEL defaults to gemini-2.5-flash.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ─── Email (bookings, staff invitations, sign-up confirmation, password reset) ─
# disabled (default): nothing is sent; booking attempts are recorded as "not configured", and new sign-ups and
#   password reset are unavailable (they answer "Email is not set up on this server").
# smtp: deliver through an SMTP server or provider over TLS. All values below are required, except that
#   SMTP_USER/SMTP_PASS may be left out outside production. SMTP_SECURE=true: TLS from the start (port 465).
#   SMTP_SECURE=false: STARTTLS is REQUIRED (port 587); without it nothing is sent. Certificates are always verified.
# Local testing: run `npm run mail:catcher` (or Mailpit) and use EMAIL_TRANSPORT=smtp, SMTP_HOST=127.0.0.1,
#   SMTP_PORT=1025, SMTP_SECURE=false, PUBLIC_APP_URL=http://localhost:5173, no SMTP_USER/SMTP_PASS. Plaintext is
#   allowed only for a loopback SMTP_HOST (localhost, 127.x.x.x, ::1) and never with NODE_ENV=production. Open the
#   emails at http://localhost:8025. See "Local email testing" and "TLS" in docs/EMAIL.md.
EMAIL_TRANSPORT=disabled
# EMAIL_FROM="WorkeasyBooking <bookings@yourdomain.com>"   # one sender for all businesses; each email names its business
# PUBLIC_APP_URL=https://book.yourdomain.com        # every link in every email is built from this address
# SMTP_HOST=smtp.yourprovider.com                   # host name or IP only (no smtp://, port or path)
# SMTP_PORT=465
# SMTP_SECURE=true                                   # true for port 465 (TLS from the start, preferred); false for 587 (STARTTLS required)
# SMTP_USER=                                         # required in production; secret: never commit real values
# SMTP_PASS=                                         # required in production; secret: never commit real values
# Retries for temporary failures: waits after the 1st, 2nd and 3rd failed attempt (milliseconds), and how often the
# background worker looks for due retries. The defaults below suit production.
# EMAIL_RETRY_DELAYS_MS=60000,300000,900000
# EMAIL_WORKER_INTERVAL_MS=30000
