{
  "name": "workeasy360",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:all": "concurrently -n api,web -c green,cyan \"npm run dev --prefix server\" \"vite\"",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test:browser": "npm run build && node scripts/browser-acceptance.mjs",
    "test:unit": "node --test \"tests/unit/*.test.ts\""
  },
  "dependencies": {
    "@headlessui/react": "^2.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "libphonenumber-js": "1.13.15",
    "lucide-react": "^0.441.0",
    "qrcode-generator": "1.4.4",
    "react": "^18.3.1",
    "react-big-calendar": "^1.13.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.53.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.12.7",
    "tailwind-merge": "^2.5.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.5",
    "@types/react-big-calendar": "^1.8.9",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.5",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
